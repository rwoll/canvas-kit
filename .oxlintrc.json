{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/templates/**",
    "**/test-results/**",
    "**/playwright-report/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/playwright.ts"
      ],
      "rules": {
        "react/rules-of-hooks": "off",
        "eslint/no-empty-pattern": "off"
      }
    }
  ]
}
