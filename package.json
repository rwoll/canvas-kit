{
  "name": "canvas-kit",
  "version": "0.2.0",
  "description": "Skills and example canvases for building Copilot canvases with @rwoll/canvas-kit.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "new-canvas": "canvas-kit new",
    "build": "pnpm -r build && vite build && canvas-kit build",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "lint": "oxlint",
    "test": "pnpm -r test && vitest run canvases ui",
    "e2e": "playwright test",
    "playwright:install": "playwright install chromium",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "consumer-test": "node scripts/consumer-test.mjs",
    "release": "canvas-kit release",
    "hero": "node docs/hero/render.mjs"
  },
  "dependencies": {
    "@rwoll/canvas-kit": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
